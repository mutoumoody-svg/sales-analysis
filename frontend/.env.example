# Browser API prefix. Keep this relative when frontend and backend share a host.
VITE_API_BASE_URL=/api/v1

# Local Vite development server
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Local production-build preview server
VITE_PREVIEW_HOST=0.0.0.0
VITE_PREVIEW_PORT=5173

# Optional for a trusted local admin browser. Prefer entering this at runtime.
VITE_ADMIN_API_KEY=
