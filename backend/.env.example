# ============================================
# Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sales_analysis

# API
API_V1_PREFIX=/api/v1
APP_NAME=AI Business Decision Platform
ENVIRONMENT=development
DEBUG=False
ADMIN_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 旺店通开放平台（不用实时同步时可以留空）
WANGDIAN_SID=
WANGDIAN_APPKEY=
WANGDIAN_APPSECRET=
WANGDIAN_SANDBOX=False

# 旺店通每日出库 JSON 目录
KUCUN_OUTPUT_PATH=./data/kucun/output
