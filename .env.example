# Copy this file to .env before running Docker Compose.

# Required: use a strong password in deployed environments.
DB_PASSWORD=CHANGE_ME

# Host port bindings
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=80

# Backend runtime
APP_NAME=AI Business Decision Platform
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=http://localhost
ADMIN_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Optional 旺店通 integration
WANGDIAN_SID=
WANGDIAN_APPKEY=
WANGDIAN_APPSECRET=
WANGDIAN_SANDBOX=false
KUCUN_OUTPUT_PATH=/opt/kucun/output
